# Required — generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
API_BEARER_TOKEN=

# Required — generate with `python -c "import secrets; print(secrets.token_hex(32))"`
STREAM_SIGNING_KEY=

# Optional
STREAM_URL_TTL_SECONDS=21600
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1,http://localhost
LOG_LEVEL=INFO
LOG_JSON=false
DEBUG=false
